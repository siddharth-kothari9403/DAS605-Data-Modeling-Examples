@prefix : <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Papers

:Paper1 rdf:type :Paper ;
        :hasAuthor :Siddharth ;
        :usesMethod :UNet ;
        :hasDomain :RemoteSensing .

:Paper2 rdf:type :Paper ;
        :hasAuthor :Alice ;
        :usesMethod :SVM ;
        :hasDomain :AI .

:Paper3 rdf:type :Paper ;
        :hasAuthor :Bob ;
        :usesMethod :ResNet ;
        :hasDomain :MedicalImaging .

# Authors

:Siddharth rdf:type :Author .
:Alice rdf:type :Author .
:Bob rdf:type :Author .

# Methods

:UNet rdf:type :DeepLearningMethod .
:ResNet rdf:type :DeepLearningMethod .
:SVM rdf:type :MachineLearningMethod .

# Domains

:RemoteSensing rdf:type :GeographyDomain .
:MedicalImaging rdf:type :HealthcareDomain .
:AI rdf:type :ComputerScienceDomain .